<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authors</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('./partials/navbar') %>

    <main class="main">
    <h1>Authors</h1>

    <% for(let oneAuthor of authors){ %>
        <section class="group">
        <h2><%= oneAuthor.name %></h2>
        <div class="books">
        <% for(let oneBook of books){ %>
           <% if(oneBook.author._id.equals(oneAuthor._id)){ %>
                <div class="covers">
                <img src="<%= oneBook.coverImg %>" alt="<%= oneBook.title %>">
                <p><%= oneBook.title %></p>
                </div>
           <% } %>
        <% } %>
        </div>
        </section>
    <% } %>
    </main>
</body>
</html>