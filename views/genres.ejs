<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Genres</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Karla:ital,wght@0,200..800;1,200..800&family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('./partials/navbar') %>

    <main class="container">
        <h1>Genres</h1>

        <% for(let oneGenre of genres){ %>
            <section class="group">
                <h2><%= oneGenre.name %></h2>
                <div class="book-grid">
                    <% for(let oneBook of books){ %>
                        <% if(oneBook.genre._id.equals(oneGenre._id)){ %>
                                <div class="book-card">
                                    <a href="/library/<%= oneBook._id %>">
                                        <img src="<%= oneBook.coverImg %>" alt="<%= oneBook.title %>">
                                        <p><%= oneBook.title %></p>
                                    </a>
                                </div>
                        <% } %>
                    <% } %>
                </div>
            </section>
        <% } %>
    </main>
</body>
</html>