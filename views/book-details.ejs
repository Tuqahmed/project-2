<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Details</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Karla:ital,wght@0,200..800;1,200..800&family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('./partials/navbar') %>

    <main class="container">
        <article class="book-details">
            <img class="book-cover" src="<%= book.coverImg %>" alt="<%= book.title %>">
            <div class="book-info">
                <h1><%= book.title %></h1>
                <p class="book-author">By <%= book.author.name %></p>

                <div class="book-meta">
                    <span class="chip"><%= book.genre.name %></span>
                    <span class="chip"><%= book.publicationYear %></span>
                </div>

                <% if(book.review){ %>
                    <section class="review">
                        <h2>Review</h2>
                        <p><%= book.review %></p>
                    </section>
                <% } %>

                <p class="registered">Registered by <%= book.owner.username %></p>

                <% if(book.owner._id.equals(user._id)){ %>
                    <div class="book-actions">
                        <!-- <a class="btn" href="/library/<%= book._id %>/edit">Edit Book</a> -->

                        <button type="button" class="btn" popovertarget="edit-popover">Edit Book</button>

                        <form action="/library/<%= book._id %>?_method=DELETE" method="post">
                            <button class="btn delete-btn">Delete Book</button>
                        </form>
                    </div>

                    <div id="edit-popover" popover>
                        <button type="button" class="dialog-close" popovertarget="edit-popover" popovertargetaction="hide" aria-label="Close">×</button>

                        <form class="book-form" action="/library/<%= book._id %>?_method=PUT" method="post">
                            <h2>Edit the Book</h2>

                            <div class="field">
                                <label for="edit-title">Title:</label>
                                <input value="<%= book.title %>" id="edit-title" name="title" type="text">
                            </div>

                            <div class="field">
                                <label for="edit-author">Author:</label>
                                <select id="edit-author" name="author">
                                    <% for(let oneAuthor of authors){ %>
                                        <option <% if(oneAuthor._id.equals(book.author._id)){ %> selected <% } %> value="<%= oneAuthor._id %>"><%= oneAuthor.name %></option>
                                    <% } %>
                                </select>
                            </div>

                            <div class="field">
                                <label for="edit-genre">Genre:</label>
                                <select id="edit-genre" name="genre">
                                    <% for(let oneGenre of genres){ %>
                                        <option <% if(oneGenre._id.equals(book.genre._id)){ %> selected <% } %> value="<%= oneGenre._id %>"><%= oneGenre.name %></option>
                                    <% } %>
                                </select>
                            </div>

                            <div class="field">
                                <label for="edit-coverImg">Cover:</label>
                                <input value="<%= book.coverImg %>" id="edit-coverImg" name="coverImg" type="text">
                            </div>

                            <div class="field">
                                <label for="edit-year">Publication Year:</label>
                                <input value="<%= book.publicationYear %>" id="edit-year" name="publicationYear" type="number">
                            </div>

                            <div class="field">
                                <label for="edit-review">Review:</label>
                                <textarea id="edit-review" name="review" rows="4"><%= book.review %></textarea>
                            </div>

                            <button>Update Book</button>
                        </form>
                    </dialog>
                <% } %>
            </div>
        </article>
    </main>

</body>
</html>