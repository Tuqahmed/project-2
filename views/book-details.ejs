<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Details</title>
</head>
<body>
    <%- include('./partials/navbar') %>

    <h1><%= book.title %></h1>
    <h2>By <%= book.author.name %></h2>
    <p>Genre: <%= book.genre.name %></p>
    <img src="<%= book.coverImg %>" alt="<%= book.title %>">
    <p>Publication Year: <%= book.publicationYear %></p>
    <p>Book registered by <%= book.owner.username %></p>

    <% if(book.owner._id.equals(user._id)){ %>
        <form action="/library/<%= book._id %>/edit" method="post">
            <button>Edit Book</button>
        </form>

        <form action="/library/<%= book._id %>?_method=DELETE" method="post">
            <button>Delete Book</button>
        </form>
    <% } %>

</body>
</html>