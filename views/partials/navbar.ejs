<nav class="navbar">
    
    <a class="home" href="/">Homepage</a>
    <div class="nav-links">
        <a href="/library">Library</a>
        <a href="/library/authors">Authors</a>
        <a href="/library/genres">Genres</a>
    </div>

    <div class="nav-auth">
        <% if (user){ %>
            <a class="nav-profile" href="/users/<%= user._id %>">
                <img src="<%= users.profilePicture %>" alt="">
            </a>
            <a class="nav-link" href="/auth/sign-out">Logout</a>

        <% } else{ %>
            <a href="/auth/sign-in">Login</a>
            <a class="nav-su" href="/auth/sign-up">Sign up</a>

        <% } %>
    </div>

    
</nav>

<% if(user){ %>
    <button class="add-book" popovertarget="add-popover" aria-label="Add a Book">+</button>
    <%- include('./add-book') %>
<% } %>


<% if (typeof toast !== 'undefined' && toast){ %>
    <div class="toast toast-<%= toast.type %>" role="status">
        <%= toast.message %>
    </div>
<% } %>