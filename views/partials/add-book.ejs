<div id="add-popover" popover>
    <button type="button" class="dialog-close" popovertarget="add-popover" popovertargetaction="hide" aria-label="Close">×</button>

    <form class="book-form" action="/library" method="post">
        <h2>Add a Book</h2>

        <div class="field">
            <label for="add-title">Title:</label>
            <input id="add-title" name="title" type="text">
        </div>

        <div class="field">
            <label for="add-author">Author:</label>
            <select id="add-author" name="author">
                <option value="">Choose an author...</option>
                <% for(let oneAuthor of authors){ %>
                    <option value="<%= oneAuthor._id %>"><%= oneAuthor.name %></option>
                <% } %>
            </select>
        </div>

        <div class="field">
            <label for="add-genre">Genre:</label>
            <select id="add-genre" name="genre">
                <option value="">Choose a genre...</option>
                <% for(let oneGenre of genres){ %>
                    <option value="<%= oneGenre._id %>"><%= oneGenre.name %></option>
                <% } %>
            </select>
        </div>

        <div class="field">
            <label for="add-coverImg">Cover:</label>
            <input id="add-coverImg" name="coverImg" type="text">
        </div>

        <div class="field">
            <label for="add-year">Publication Year:</label>
            <input id="add-year" name="publicationYear" type="number">
        </div>

        <div class="field">
            <label for="status">Status:</label>
            <select id="status" name="status">
                <option value="">Choose the status...</option>
                <% for(let oneStatus of statuses){ %>
                    <option value="<%= oneStatus._id %>"><%= oneStatus.name %></option>
                <% } %>
            </select>
        </div>

        <div class="field">
            <label for="rating">Rating:</label>
            <select id="rating" name="rating">
                <option value="">Choose your rating...</option>
                <% for(let oneRating of ratings){ %>
                    <option value="<%= oneRating._id %>"><%= oneRating.name %></option>
                <% } %>
            </select>
        </div>

        <div class="field">
            <label for="add-review">Review:</label>
            <textarea id="add-review" name="review" rows="4"></textarea>
        </div>

        <button>Add Book</button>
    </form>
</div>