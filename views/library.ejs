<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library</title>
</head>
<body>
    <%- include('./partials/navbar') %>

    <h1>The Library</h1>

    <% for(let oneBook of books){ %>
        <a href="/library/<%= oneBook._id %>"><%= oneBook.title %> by <%= oneBook.author.name%></a>
        <img src="<%= oneBook.coverImg %>" alt="<%= oneBook.title %>">
    <% } %>
</body>
</html>