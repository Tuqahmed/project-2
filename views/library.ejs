<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Library</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('./partials/navbar') %>

    <main class="main">
        <h1>The Library</h1>

        <div class="books">
            <% for(let oneBook of books){ %>
                <a class="book-title" href="/library/<%= oneBook._id %>">
                    <img src="<%= oneBook.coverImg %>" alt="<%= oneBook.title %>">
                    <h3><%= oneBook.title %></h3>
                    <p><%= oneBook.author.name%></p>
                </a>
            <% } %>
        </div>
    </main>
</body>
</html>