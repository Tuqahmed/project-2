<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Karla:ital,wght@0,200..800;1,200..800&family=Libre+Caslon+Condensed:ital,wght@0,400..700;1,400..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('./partials/navbar') %>

    <main class="container">
        <h1>Edit the Book</h1>

        <form class="book-form" action="/library/<%= book._id %>?_method=PUT" method="post">
            <div class="field">
                <label for="title">Title:</label>
                <input value="<%= book.title %>" name="title" id="title" type="text">
            </div>

            <div class="field">
                <label for="author">Author:</label>
                <select name="author" id="author">
                    <% for(let oneAuthor of authors){ %>
                        <option <% if(oneAuthor._id.equals(book.author._id)){ %> selected <% } %> value="<%= oneAuthor._id %>"><%= oneAuthor.name %></option>
                    <% } %>
                </select>
            </div>

            <div class="field">
                <label for="genre">Genre:</label>
                <select name="genre" id="genre">
                    <% for(let oneGenre of genres){ %>
                        <option <% if(oneGenre._id.equals(book.genre._id)){ %> selected <% } %> value="<%= oneGenre._id %>"><%= oneGenre.name %></option>
                    <% } %>
                </select>
            </div>

            <div class="field">
                <label for="coverImg">Cover:</label>
                <input value="<%= book.coverImg %>" name="coverImg" id="coverImg" type="text">
            </div>

            <div class="field">
                <label for="publicationYear">Publication Year:</label>
                <input value="<%= book.publicationYear %>" name="publicationYear" id="publicationYear" type="number">
            </div>

            <div class="field">
                <label for="review">Book Review:</label>
                <textarea name="review" id="review" rows="5"><%= book.review %></textarea>
            </div>

            <button>Update Book</button>
        </form>
    </main>
</body>
</html>